NODE_ENV=development
PORT=3002

# Conexión con el rol butaca_app (sin BYPASSRLS) por el pooler de Supabase.
# Nunca usar el rol postgres ni la service_role key en los servicios.
DATABASE_URL=postgresql://butaca_app.<proyecto>:<contraseña>@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Supabase firma los tokens con ES256; se validan con la clave pública (JWKS) de SUPABASE_URL.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_JWT_ISSUER=https://<proyecto>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Solo si el proyecto firmara con HS256 (secreto compartido):
# SUPABASE_JWT_SECRET=

# Opcional: tokens de dos usuarios de prueba para las pruebas de integración.
# Sin ellos, esas pruebas se omiten.
# TEST_JWT=
# TEST_JWT_2=
