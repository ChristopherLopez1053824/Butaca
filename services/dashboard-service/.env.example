NODE_ENV=development
PORT=3005

# Supabase firma los tokens con ES256; se validan con la clave pública (JWKS) de SUPABASE_URL.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_JWT_ISSUER=https://<proyecto>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Solo si el proyecto firmara con HS256 (secreto compartido):
# SUPABASE_JWT_SECRET=

# Servicios que consulta para armar el resumen.
EMOTION_SERVICE_URL=http://localhost:3002
MOVIE_SERVICE_URL=http://localhost:3003
FAVORITES_SERVICE_URL=http://localhost:3004
MEME_SERVICE_URL=http://localhost:3006
