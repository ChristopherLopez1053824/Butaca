NODE_ENV=development
PORT=3006

# Proveedor de contenido bíblico. Solo "api.bible" está implementado hoy
# (ver src/clients/bible.client.js). Deja BIBLE_API_KEY vacía si todavía no
# tienes una: el servicio arranca igual y responde un error controlado
# (503 SERVICE_NOT_CONFIGURED) solo cuando alguien pide un versículo.
BIBLE_API_PROVIDER=api.bible
BIBLE_API_BASE_URL=https://rest.api.bible/v1
BIBLE_API_KEY=
# BIBLE_API_TRANSLATION es el bibleId real que te da api.bible al consultar
# GET /v1/bibles con tu clave (un identificador opaco, no un código de
# traducción). RVR1960 y NVI son traducciones con copyright que requieren
# una licencia aparte de api.bible/Biblica — tu clave puede no tenerlas
# habilitadas (verifícalo con GET /v1/bibles). El valor de ejemplo de abajo
# es el bibleId real de Reina Valera 1909 (RVR09, dominio público), que se
# usa como traducción temporal mientras se gestiona la licencia de RVR1960.
BIBLE_API_TRANSLATION=592420522e16049f-01
BIBLE_API_TIMEOUT_MS=5000

SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
DATABASE_URL=
