FROM node:24-alpine AS build

RUN npm install --global pnpm@10.34.9

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile

# VITE_API_URL / VITE_SUPABASE_* ya no son build args: Render Blueprint no
# permite pasarlos por render.yaml. Se inyectan en tiempo de arranque del
# contenedor vía /env.js (ver web-entrypoint.sh e index.html).
RUN pnpm --filter @butaca/web build

FROM nginx:alpine

COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/web-entrypoint.sh /docker-entrypoint.d/40-butaca-env.sh
RUN chmod +x /docker-entrypoint.d/40-butaca-env.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
