# Copia este archivo como infrastructure/docker/.env y rellena los valores.
# No subas .env al repositorio.

# Frontend: se incrustan al construir la imagen.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Auth para el backend.
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Base de datos de ejecución.
DATABASE_URL=
# Solo para migraciones y tareas administrativas de Prisma.
DIRECT_URL=

# TMDB y recomendaciones.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
RECOMMENDATIONS_CURSOR_SECRET=

# Opcionales.
NODE_ENV=production
WEB_URL=http://localhost:5173
PROXY_TIMEOUT_MS=15000
TRUST_PROXY=0
LOG_REQUESTS=true
EMOTION_SERVICE_TIMEOUT_MS=5000
