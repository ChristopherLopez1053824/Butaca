    {
      "name": "5. Recomendaciones",
      "item": [
        {
          "name": "Pedir recomendaciones",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/movies/recommendations",
            "description": "Movie consulta la emoción en Emotion Service y busca en TMDB. Puede tardar unos segundos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emotionRecordId\": \"{{emotionRecordId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().data;",
                  "pm.test('Trae recomendaciones', () => pm.expect(items.length).to.be.above(0));",
                  "const r = items[0];",
                  "pm.collectionVariables.set('tmdbId', r.tmdbId);",
                  "pm.collectionVariables.set('mediaType', r.mediaType);",
                  "const favorito = { tmdbId: r.tmdbId, mediaType: r.mediaType, title: r.title, posterPath: r.posterPath ?? null, releaseDate: r.releaseDate ?? null, voteAverage: r.voteAverage ?? null };",
                  "pm.collectionVariables.set('favoriteBody', JSON.stringify(favorito));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver recomendaciones guardadas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/movies/recommendations?emotionRecordId={{emotionRecordId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver detalle en TMDB",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/movies/details/{{tmdbId}}?mediaType={{mediaType}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Favoritos",
      "item": [
        {
          "name": "Guardar la primera recomendación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/favorites",
            "description": "Usa la primera película de \"Pedir recomendaciones\". Si ya existe, responde 409.",
            "body": {
              "mode": "raw",
              "raw": "{{favoriteBody}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 o 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('favoriteId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver mis favoritos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/favorites?page=1&limit=20",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json().data;",
                  "if (!pm.collectionVariables.get('favoriteId') && lista.length) pm.collectionVariables.set('favoriteId', lista[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar el favorito",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/favorites/{{favoriteId}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
