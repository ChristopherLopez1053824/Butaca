              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver historial",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/emotions?page=1&limit=10",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Trae pagination', () => pm.expect(pm.response.json().pagination).to.be.an('object'));"
                ]
              }
            }
          ]
        },
