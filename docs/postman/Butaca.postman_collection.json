    {
      "name": "4. Emociones",
      "item": [
        {
          "name": "Registrar emoción manual",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/emotions",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emotion\": \"SAD\",\n  \"source\": \"MANUAL\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const registro = pm.response.json().data;",
                  "pm.test('Formato común (status ok)', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.collectionVariables.set('emotionRecordId', registro.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar emoción con cámara",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/emotions",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emotion\": \"FRUSTRATION\",\n  \"source\": \"CAMERA\",\n  \"confidence\": 0.87\n}"
