    {
      "name": "3. Usuario",
      "item": [
        {
          "name": "Ver mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "description": "Si responde 404, el trigger de Supabase no creó el perfil del usuario."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es mi usuario', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar mi nombre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/me",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Prueba Butaca\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().data.displayName).to.eql('Prueba Butaca'));"
                ]
              }
            }
          ]
