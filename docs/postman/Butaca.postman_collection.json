{
  "info": {
    "_postman_id": "80f661a4-ed2a-4a22-8fe2-12feeba4ba15",
    "name": "Butaca - pruebas por el Gateway",
    "description": "Recorre el flujo completo a través del API Gateway: login, emoción, recomendaciones y favoritos.\n\nAntes de empezar, llena anonKey, email y password en las variables de la colección. Luego ejecuta las carpetas en orden, o la colección completa con Run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Iniciar sesión (email y contraseña)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{anonKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
        "description": "Obtiene un JWT del usuario de prueba y lo guarda en la variable token. Requiere anonKey, email y password en las variables de la colección.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const sesion = pm.response.json();",
              "pm.test('Devuelve access_token', () => pm.expect(sesion.access_token).to.be.a('string'));",
              "pm.collectionVariables.set('token', sesion.access_token);",
              "pm.collectionVariables.set('userId', sesion.user && sesion.user.id);"
            ]
          }
        }
      ]
    },
