{
  "name": "butaca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @butaca/web dev\" \"pnpm --parallel --filter './services/*' dev\"",
    "dev:web": "pnpm --filter @butaca/web dev",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @butaca/database db:generate",
    "db:migrate": "pnpm --filter @butaca/database db:migrate",
    "db:studio": "pnpm --filter @butaca/database db:studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6"
  }
}
